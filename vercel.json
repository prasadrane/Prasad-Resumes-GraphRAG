{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "input/**,config/**,src/web/static/**,output/**"
    }
  },
  "build": {
    "env": {
      "PYTHON_VERSION": "3.12"
    }
  },
  "env": {
    "OUTPUT_DIR": "/tmp/output"
  }
}
